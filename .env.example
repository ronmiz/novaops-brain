# Variable NAMES only. Real values live in the shared lessons/.env (one level above
# this repo), which find_dotenv() picks up automatically. Never commit values.

# Bedrock (shared keys)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# OpenSearch Serverless (own account — owns the collection)
OPENSEARCH_COLLECTION=novaops-rag
OPENSEARCH_AWS_ACCESS_KEY_ID=
OPENSEARCH_AWS_SECRET_ACCESS_KEY=

# Optional overrides
# NOVAOPS_INDEX=novaops-brain-kb
# NOVAOPS_DATASET_DIR=../Final Project - Company Brain/project/novaops-enterprise-agent-dataset
# NOVAOPS_DB_PATH=var/novaops.db
# NOVAOPS_MCP_PORT=9880
